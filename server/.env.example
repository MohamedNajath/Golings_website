# ───── Goalings API: copy to .env and fill in. NEVER commit .env ─────
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://goalings:CHANGE_ME@localhost:5432/goalings
# Set to true if your managed Postgres requires SSL
DATABASE_SSL=false

# Public website origin(s) allowed to call the API (comma separated). Needed only if the site is on a different origin.
FRONTEND_ORIGIN=http://localhost:5173

# Long random strings (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FORM_TOKEN_SECRET=

# Where CVs are stored. Must be OUTSIDE any publicly served folder and backed up.
UPLOAD_DIR=./storage/cvs
MAX_CV_MB=5

# Set true to let this server also serve the built website from ../dist (single-server deployment)
SERVE_FRONTEND=false
# Set true when running behind a reverse proxy / load balancer (needed for correct client IPs)
TRUST_PROXY=false

# ───── Email (SMTP). If SMTP_HOST is empty, emails are skipped (and recorded as "skipped") ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Goalings <no-reply@goalings.com>"
# Receives a notification for every new application
ADMIN_NOTIFY_EMAIL=
